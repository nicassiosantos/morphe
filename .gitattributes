# Os arquivos cobertos por PROVENIENCIA.sha256 precisam sair do clone com os
# bytes exatos que sairam da estacao de trabalho e da placa. Sem isto, a
# conversao automatica de fim de linha no Windows quebraria a verificacao.
Quartus/conv1d.v             -text
Quartus/fir_wrapper.v        -text
Quartus/ghrd_top.v           -text
Quartus/soc_system.qsys      -text
Quartus/soc_system.sopcinfo  -text
C/hps_0.h                    -text
C/morphe_config.h            -text
C/morphe_server.c            -text
C/address_map_arm.h          -text

# Artefatos binarios
*.sof   binary
*.rbf   binary
*.pof   binary

# Scripts de shell precisam sair do clone com LF mesmo em checkout no Windows.
# Um .sh com CRLF falha no Linux com "bad interpreter: /bin/bash^M", que nao
# parece um problema de fim de linha para quem le a mensagem.
*.sh text eol=lf

# O proprio arquivo de conferencia precisa de LF. Com CRLF, o sha256sum le
# 'Quartus/conv1d.v' como nome de arquivo e os DEZ falham com "No such
# file or directory" -- num clone Windows a verificacao nunca funcionou.
PROVENIENCIA.sha256  text eol=lf
